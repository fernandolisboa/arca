{
  "name": "@arca/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./host": "./src/host.ts",
    "./json": "./src/json-subset.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:bootstrap": "node src/db/cli.ts bootstrap",
    "db:migrate": "node src/db/cli.ts migrate",
    "db:seed": "node src/db/cli.ts seed",
    "db:runtime-config": "node src/db/cli.ts runtime-config",
    "smoke": "node src/smoke.ts"
  },
  "dependencies": {
    "libpg-query": "catalog:",
    "pg": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@arca/eslint-config": "workspace:*",
    "@arca/security-policy": "workspace:*",
    "@arca/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
