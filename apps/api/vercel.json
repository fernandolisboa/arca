{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nitro",
  "buildCommand": "cd ../.. && pnpm --fail-if-no-match --filter @arca/scripts db:build && pnpm turbo run build --filter=@arca/api",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/internal/cron/heartbeat",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/internal/cron/retention",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/internal/cron/account-erasure",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/internal/cron/rate-limit-sweep",
      "schedule": "30 6 * * *"
    }
  ]
}
