{
  "schemaVersion": 1,
  "routeId": "qr-sponsored-job",
  "number": 1,
  "title": "Fixture: sponsored skilled job offer with a salary threshold",
  "country": "QR",
  "tags": ["fixture", "work"],
  "effectiveFrom": "2020-01-01",
  "status": "open",
  "currency": "EUR",
  "sources": [
