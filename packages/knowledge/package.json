{
  "name": "@arca/knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./display": {
      "types": "./dist/display.d.ts",
      "default": "./dist/display.js"
    },
    "./reproduction": {
      "types": "./dist/reproduction.d.ts",
      "default": "./dist/reproduction.js"
    }
  },
  "scripts": {
    "catalog": "node scripts/build.ts",
    "countries:generate": "node scripts/generate-countries.ts",
    "comparison:fetch": "node scripts/fetch-world-bank.ts",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "staleness-report": "node scripts/staleness-report.ts"
  },
  "dependencies": {
    "@arca/domain": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arca/eslint-config": "workspace:*",
    "@arca/scripts": "workspace:*",
    "@arca/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
