  "requirements": [
    {
      "id": "remote-income",
      "title": "Average monthly income from work over the last three months of at least four times the 2026 minimum wage (EUR 3,680)",
      "expression": {
        "op": "gte",
        "left": {
          "op": "fact",
          "key": "principal.monthlyActiveIncome"
        },
        "right": {
          "op": "mul",
          "operand": {
            "op": "money",
            "amount": 92000,
            "currency": "EUR"
          },
          "by": "4"
        }
      },
      "sources": ["dr-84-2007", "dl-139-2025"]
    },
    {
      "id": "household-means",
      "title": "Monthly income of the 2026 minimum wage net of the 11% social security contribution (EUR 818.80, from EUR 920) for the principal, plus 50% of it per other adult and 30% per child under 18",
      "expression": {
        "op": "gte",
        "left": {
          "op": "add",
          "left": {
            "op": "sum",
            "over": "unit.members",
            "value": {
              "op": "fact",
              "key": "person.monthlyActiveIncome"
            }
          },
          "right": {
            "op": "sum",
            "over": "unit.members",
            "value": {
              "op": "fact",
              "key": "person.monthlyPassiveIncome"
            }
          }
        },
        "right": {
          "op": "add",
          "left": {
            "op": "mul",
            "operand": {
              "op": "money",
              "amount": 92000,
              "currency": "EUR"
            },
            "by": "0.89"
          },
          "right": {
            "op": "add",
            "left": {
              "op": "sum",
              "over": "unit.dependents",
              "value": {
                "op": "mul",
                "operand": {
                  "op": "mul",
                  "operand": {
                    "op": "money",
                    "amount": 92000,
                    "currency": "EUR"
                  },
                  "by": "0.89"
                },
                "by": "0.5"
              },
              "where": {
                "op": "gte",
                "left": {
                  "op": "fact",
                  "key": "person.ageYears"
                },
                "right": {
                  "op": "int",
                  "value": 18
                }
              }
            },
            "right": {
              "op": "sum",
              "over": "unit.dependents",
              "value": {
                "op": "mul",
                "operand": {
                  "op": "mul",
                  "operand": {
                    "op": "money",
                    "amount": 92000,
                    "currency": "EUR"
                  },
                  "by": "0.89"
                },
                "by": "0.3"
              },
              "where": {
                "op": "lt",
                "left": {
                  "op": "fact",
                  "key": "person.ageYears"
                },
                "right": {
                  "op": "int",
                  "value": 18
                }
              }
            }
          }
        }
      },
      "sources": ["portaria-1563-2007", "dl-139-2025", "codigo-contributivo", "dr-84-2007-means"]
    },
    {
      "id": "not-eu-eea-or-swiss-citizen",
      "title": "Not a citizen of an EU or EEA state or of Switzerland, Portugal included: the foreigners law, and so this visa, does not apply to them",
      "expression": {
        "op": "not",
        "operand": {
          "op": "intersects",
          "list": {
            "op": "fact",
            "key": "principal.citizenships"
          },
          "set": {
            "op": "set",
            "id": "eu-free-movement"
          }
        }
      },
      "sources": ["lei-23-2007-scope"]
    }
  ],
  "assessments": [
    {
      "id": "remote-work",
      "title": "Work done remotely for people or companies domiciled or seated outside Portugal, shown by a work contract or employer's statement, or by a company or services contract or proof of services provided",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["lei-23-2007-remote", "dr-84-2007"]
    },
    {
      "id": "tax-residence",
      "title": "A document attesting the applicant's tax residence",
      "evidence": ["principal.residenceCountry"],
      "sources": ["dr-84-2007"]
    },
    {
      "id": "no-entry-ban",
      "title": "No entry ban in force after a removal from Portugal, and no alert for return or for refusal of entry and stay in the Schengen Information System or in Portugal's border system",
      "evidence": ["principal.visaRefusals"],
      "sources": ["lei-23-2007-conditions"]
    },
    {
      "id": "criminal-record",
      "title": "No conviction for a crime that Portugal punishes with more than one year of prison, even if the sentence was not served or was suspended; a criminal record certificate is asked from age 16",
      "evidence": ["principal.visaRefusals"],
      "sources": ["lei-23-2007-conditions", "dr-84-2007-documents"]
    }
  ],
  "dependents": [
