  "countrySets": [],
  "requirements": [
    {
      "id": "japanese-descent",
      "title": "A biological grandchild of a Japanese national: the parent was born while the grandparent was Japanese, or the grandparent was born to a Japanese national and once had a Japanese family register",
      "expression": {
        "op": "any",
        "operands": [
          {
            "op": "some",
            "over": "principal.ancestors",
            "generations": 2,
            "where": {
              "op": "all",
              "operands": [
                {
                  "op": "eq",
                  "left": {
                    "op": "fact",
                    "key": "lineage.generation"
                  },
                  "right": {
                    "op": "int",
                    "value": 2
                  }
                },
                {
                  "op": "eq",
                  "left": {
                    "op": "fact",
                    "key": "lineage.edgeKind"
                  },
                  "right": {
                    "op": "token",
                    "value": "biological"
                  }
                },
                {
                  "op": "intersects",
                  "list": {
                    "op": "fact",
                    "key": "lineage.citizenshipsAtChildBirth"
                  },
                  "set": {
                    "op": "tokens",
                    "values": [
                      "JP"
                    ]
                  }
                },
                {
                  "op": "every",
                  "over": "lineage.links",
                  "where": {
                    "op": "eq",
                    "left": {
                      "op": "fact",
                      "key": "lineage.edgeKind"
                    },
                    "right": {
                      "op": "token",
                      "value": "biological"
                    }
                  }
                }
              ]
            }
          },
          {
            "op": "some",
            "over": "principal.ancestors",
            "generations": 3,
            "where": {
              "op": "all",
              "operands": [
                {
                  "op": "eq",
                  "left": {
                    "op": "fact",
                    "key": "lineage.generation"
                  },
                  "right": {
                    "op": "int",
                    "value": 3
                  }
                },
                {
                  "op": "eq",
                  "left": {
                    "op": "fact",
                    "key": "lineage.edgeKind"
                  },
                  "right": {
                    "op": "token",
                    "value": "biological"
                  }
                },
                {
                  "op": "intersects",
                  "list": {
                    "op": "fact",
                    "key": "lineage.citizenshipsAtChildBirth"
                  },
                  "set": {
                    "op": "tokens",
                    "values": [
                      "JP"
                    ]
                  }
                },
                {
                  "op": "every",
                  "over": "lineage.links",
                  "where": {
                    "op": "eq",
                    "left": {
                      "op": "fact",
                      "key": "lineage.edgeKind"
                    },
                    "right": {
                      "op": "token",
                      "value": "biological"
                    }
                  }
                },
                {
                  "op": "unmodeled"
                }
              ]
            }
          }
        ]
      },
      "sources": [
        "teijusha-notice",
        "immigration-act"
      ]
    },
    {
      "id": "not-japanese-national",
      "title": "Not a Japanese national: statuses of residence are only for foreigners, who hold no Japanese nationality",
      "expression": {
        "op": "not",
        "operand": {
          "op": "intersects",
          "list": {
            "op": "fact",
            "key": "principal.citizenships"
          },
          "set": {
            "op": "tokens",
            "values": [
              "JP"
            ]
          }
        }
      },
      "sources": [
        "immigration-act"
      ]
    }
  ],
  "assessments": [
    {
      "id": "good-conduct",
      "title": "Good conduct, and none of the grounds for refusing landing (criminal record, earlier deportation and the others in art. 5 of the act)",
      "evidence": [
        "principal.visaRefusals"
      ],
      "sources": [
        "teijusha-notice",
        "immigration-act"
      ]
    },
    {
      "id": "family-conditions",
      "title": "If family come: a marriage Japan recognizes; whoever they rely on (the principal, or the spouse for the spouse's children) gets a stay of a year or more; spouse and biological children of good conduct",
      "evidence": [
        "principal.hasSpouse"
      ],
      "sources": [
        "teijusha-notice"
      ]
    }
  ],
  "dependents": [
    {
      "id": "spouse",
      "title": "Spouse",
      "path": [
        "spouse"
      ],
      "condition": {
        "op": "bool",
        "value": true
      },
      "sources": [
        "teijusha-notice"
      ]
    },
    {
      "id": "children",
      "title": "Unmarried biological children under 18 whom the principal supports",
      "path": [
        "child"
      ],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "biological"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 18
            }
          },
          {
            "op": "not",
            "operand": {
              "op": "fact",
              "key": "person.hasSpouse"
            }
          },
          {
            "op": "fact",
            "key": "person.dependsOnPrincipal"
          }
        ]
      },
      "sources": [
        "teijusha-notice",
        "civil-code"
      ]
    },
    {
      "id": "adopted-children",
      "title": "Adopted children under 6 whom the principal supports",
      "path": [
        "child"
      ],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "adoptive"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 6
            }
          },
          {
            "op": "fact",
            "key": "person.dependsOnPrincipal"
          }
        ]
      },
      "sources": [
        "teijusha-notice"
      ]
    },
    {
      "id": "spouse-children",
      "title": "The spouse's unmarried biological children under 18 whom the principal or the spouse supports",
      "path": [
        "spouse",
        "child"
      ],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "biological"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 18
            }
          },
          {
            "op": "not",
            "operand": {
              "op": "fact",
              "key": "person.hasSpouse"
            }
          },
          {
            "op": "any",
            "operands": [
              {
                "op": "fact",
                "key": "person.dependsOnPrincipal"
              },
              {
                "op": "fact",
                "key": "edge.dependsOnLinkedPerson"
              }
            ]
          }
        ]
      },
      "sources": [
        "teijusha-notice",
        "civil-code"
      ]
    },
    {
      "id": "spouse-adopted-children",
      "title": "The spouse's adopted children under 6 whom the principal or the spouse supports",
      "path": [
        "spouse",
        "child"
      ],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "adoptive"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 6
            }
          },
          {
            "op": "any",
            "operands": [
              {
                "op": "fact",
                "key": "person.dependsOnPrincipal"
              },
              {
                "op": "fact",
                "key": "edge.dependsOnLinkedPerson"
              }
            ]
          }
        ]
      },
      "sources": [
        "teijusha-notice"
      ]
    }
  ],
  "costs": [],
  "durations": [
    {
      "id": "period-of-stay",
      "title": "Period of stay as a long-term resident (teijusha) of a status the notice sets: 5 years, 3 years, 1 year or 6 months, then renewable",
      "min": "P6M",
      "max": "P60M",
      "sources": [
