  "requirements": [
    {
      "id": "household-means",
      "title": "A year of passive income plus liquid assets of 400% of the IPREM (Spain's income index, EUR 600) a month for the principal, plus 100% per dependent: EUR 2,400 and EUR 600",
      "expression": {
        "op": "gte",
        "left": {
          "op": "add",
          "left": {
            "op": "mul",
            "operand": {
              "op": "sum",
              "over": "unit.members",
              "value": {
                "op": "fact",
                "key": "person.monthlyPassiveIncome"
              }
            },
            "by": "12"
          },
          "right": {
            "op": "fact",
            "key": "unit.liquidAssets"
          }
        },
        "right": {
          "op": "mul",
          "operand": {
            "op": "add",
            "left": {
              "op": "money",
              "amount": 240000,
              "currency": "EUR"
            },
            "right": {
              "op": "sum",
              "over": "unit.dependents",
              "value": {
                "op": "money",
                "amount": 60000,
                "currency": "EUR"
              }
            }
          },
          "by": "12"
        }
      },
      "sources": ["rd-1155-2024", "ley-31-2022", "orden-efd-581-2026"]
    }
  ],
  "assessments": [],
  "dependents": [
    {
      "id": "spouse",
      "title": "Spouse",
      "path": ["spouse"],
      "condition": {
