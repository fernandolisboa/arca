  "requirements": [
    {
      "id": "capital",
      "title": "Capital to invest of at least USD 800,000 (targeted employment area or infrastructure project; USD 1,050,000 elsewhere)",
      "expression": {
        "op": "gte",
        "left": {
          "op": "fact",
          "key": "unit.liquidAssets"
        },
        "right": {
          "op": "money",
          "amount": 80000000,
          "currency": "USD"
        }
      },
      "sources": ["usc-1153"]
    }
  ],
  "assessments": [
    {
      "id": "lawful-source",
      "title": "The capital was obtained through lawful means, with a documented path of funds",
      "evidence": [
        "principal.monthlyActiveIncome",
        "principal.monthlyPassiveIncome",
        "unit.liquidAssets"
      ],
      "sources": ["cfr-204-6"]
    },
    {
      "id": "at-risk",
      "title": "The capital is placed at risk in a new commercial enterprise, beyond a mere intent to invest",
      "evidence": ["unit.liquidAssets"],
      "sources": ["usc-1153", "cfr-204-6"]
    },
    {
      "id": "job-creation",
      "title": "The enterprise will create at least 10 full-time jobs for qualifying employees",
      "evidence": ["unit.liquidAssets"],
      "sources": ["usc-1153", "cfr-204-6"]
    }
  ],
  "dependents": [
    {
      "id": "spouse",
      "title": "Spouse",
      "path": ["spouse"],
      "condition": {
        "op": "bool",
        "value": true
      },
      "sources": ["usc-1153"]
    },
    {
      "id": "children",
      "title": "Unmarried biological children under 21",
      "path": ["child"],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 21
            }
          },
          {
            "op": "not",
            "operand": {
              "op": "fact",
              "key": "person.hasSpouse"
            }
          },
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "biological"
            }
          }
        ]
      },
      "sources": ["usc-1153", "usc-1101"]
    },
    {
      "id": "adopted-children",
      "title": "Unmarried adopted children under 21, adopted before 16 with two years of custody (adopted at 16 or 17, or custody still short: possible)",
      "path": ["child"],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 21
            }
          },
          {
            "op": "not",
            "operand": {
              "op": "fact",
              "key": "person.hasSpouse"
            }
          },
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "adoptive"
            }
          },
          {
            "op": "any",
            "operands": [
              {
                "op": "all",
                "operands": [
                  {
                    "op": "lt",
                    "left": {
                      "op": "fact",
                      "key": "edge.ageAtStart"
                    },
                    "right": {
                      "op": "int",
                      "value": 16
                    }
                  },
                  {
                    "op": "since",
                    "date": {
                      "op": "fact",
                      "key": "edge.custodyStart"
                    },
                    "duration": "P2Y"
                  }
                ]
              },
              {
                "op": "all",
                "operands": [
                  {
                    "op": "lt",
                    "left": {
                      "op": "fact",
                      "key": "edge.ageAtStart"
                    },
                    "right": {
                      "op": "int",
                      "value": 18
                    }
                  },
                  {
                    "op": "unmodeled"
                  }
                ]
              }
            ]
          }
        ]
      },
      "sources": ["usc-1153", "usc-1101"]
    },
    {
      "id": "stepchildren",
      "title": "Unmarried stepchildren under 21 whose parent married the principal before they turned 18",
      "path": ["spouse", "child"],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 21
            }
          },
          {
            "op": "not",
            "operand": {
              "op": "fact",
              "key": "person.hasSpouse"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "firstEdge.ageAtStart"
            },
            "right": {
              "op": "int",
              "value": 18
            }
          }
        ]
      },
      "sources": ["usc-1153", "usc-1101"]
    }
  ],
  "costs": [
    {
      "id": "investment",
