  "requirements": [
    {
      "id": "capital",
      "title": "Capital to invest of at least USD 800,000 (targeted employment area or infrastructure project; USD 1,050,000 elsewhere), for petitions filed before 2027-01-01",
      "expression": {
        "op": "gte",
        "left": {
          "op": "fact",
          "key": "unit.liquidAssets"
        },
        "right": {
          "op": "money",
          "amount": 80000000,
          "currency": "USD"
        }
      },
      "sources": ["usc-1153-capital"]
    }
  ],
  "assessments": [
    {
      "id": "lawful-source",
      "title": "The capital, and the money for the investment's fees and costs, come from a lawful source through lawful means, with a documented path of funds",
      "evidence": [
        "principal.monthlyActiveIncome",
        "principal.monthlyPassiveIncome",
        "unit.liquidAssets"
      ],
      "sources": ["usc-1153", "cfr-204-6"]
    },
    {
      "id": "at-risk",
      "title": "The capital is invested, or actively being invested, at risk in a new commercial enterprise, with a present commitment beyond a mere intent to invest",
      "evidence": ["unit.liquidAssets"],
      "sources": ["usc-1153", "cfr-204-6"]
    },
    {
      "id": "investment-term",
      "title": "The capital is expected to remain invested for at least 2 years",
      "evidence": ["unit.liquidAssets"],
      "sources": ["usc-1153-term"]
    },
    {
      "id": "job-creation",
      "title": "The enterprise will create at least 10 full-time jobs for qualifying employees, not counting the investor or the investor's spouse, sons and daughters",
      "evidence": ["unit.liquidAssets"],
      "sources": ["usc-1153", "cfr-204-6"]
    },
    {
      "id": "engagement",
      "title": "The investor is or will be engaged in managing the enterprise, by day-to-day managerial control or policy formulation, not in a purely passive role; a limited partner with the usual rights counts",
      "evidence": ["unit.liquidAssets"],
      "sources": ["cfr-204-6-2019", "proposed-rule-2026"]
    }
  ],
  "dependents": [
    {
