                    },
                    "right": {
                      "op": "int",
                      "value": 18
                    }
                  },
                  {
                    "op": "unmodeled"
                  }
                ]
              }
            ]
          }
        ]
      },
      "sources": ["usc-1153", "usc-1101"]
    },
    {
      "id": "stepchildren",
