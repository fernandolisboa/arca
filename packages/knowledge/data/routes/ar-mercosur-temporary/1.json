  "requirements": [
    {
      "id": "mercosur-native-nationality",
      "title": "Native national of a Mercosur member or associated state the migration directorate lists, or naturalized for five years or more in one of the eight states it lists for that",
      "expression": {
        "op": "any",
        "operands": [
          {
            "op": "intersects",
            "list": {
              "op": "fact",
              "key": "principal.citizenshipsFromBirth"
            },
            "set": {
              "op": "tokens",
              "values": ["BO", "BR", "CL", "CO", "EC", "GY", "PE", "PY", "SR", "UY", "VE"]
            }
          },
          {
            "op": "all",
            "operands": [
              {
                "op": "intersects",
                "list": {
                  "op": "fact",
                  "key": "principal.citizenships"
                },
                "set": {
                  "op": "tokens",
                  "values": ["BO", "BR", "CL", "CO", "EC", "PE", "PY", "UY"]
                }
              },
              {
                "op": "unmodeled"
              }
            ]
          }
        ]
      },
      "sources": ["ley-25871", "decreto-616-2010", "dnm-mercosur"]
    }
  ],
  "assessments": [],
