    }
  ],
  "assessments": [
    {
      "id": "invitation",
      "title": "An invitation in writing from the Minister to apply, and an application made within the period it states",
      "evidence": ["principal.ageYears"],
      "sources": ["regs-1137-invitation", "regs-189-criteria"]
    },
    {
      "id": "skills-assessment",
      "title": "A skilled occupation on the Minister's list, named in the invitation, with a positive skills assessment by its assessing authority, at most 3 years old at invitation",
      "evidence": ["principal.educationLevel"],
      "sources": ["regs-1137-invitation", "regs-189-criteria"]
    },
    {
      "id": "competent-english",
      "title": "Competent English at the time of invitation: a specified test score from the last 3 years, or a passport of a type the Minister specifies",
      "evidence": ["principal.citizenships"],
      "sources": ["regs-189-criteria", "regs-competent-english"]
    },
    {
      "id": "points-score",
      "title": "A points-test score at least the score in the invitation and the pass mark, from age, English, work experience, qualifications, the partner's skills and other attributes",
      "evidence": ["principal.ageYears", "principal.educationLevel"],
      "sources": ["regs-189-criteria", "regs-points-test"]
    }
