  "requirements": [
    {
      "id": "under-45",
      "title": "Under 45: the invitation to apply must come before the 45th birthday",
      "expression": {
        "op": "lt",
        "left": {
          "op": "fact",
          "key": "principal.ageYears"
        },
        "right": {
          "op": "int",
          "value": 45
        }
      },
