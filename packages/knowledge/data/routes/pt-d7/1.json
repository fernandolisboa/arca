  "requirements": [
    {
      "id": "household-income",
      "title": "Monthly passive income of the 2026 minimum wage (EUR 920) for the principal, plus 50% of it per other adult and 30% per child under 18",
      "expression": {
        "op": "gte",
        "left": {
          "op": "sum",
          "over": "unit.members",
          "value": {
            "op": "fact",
            "key": "person.monthlyPassiveIncome"
          }
        },
        "right": {
          "op": "add",
          "left": {
            "op": "money",
            "amount": 92000,
            "currency": "EUR"
          },
          "right": {
            "op": "add",
            "left": {
              "op": "sum",
              "over": "unit.dependents",
              "value": {
                "op": "mul",
                "operand": {
                  "op": "money",
                  "amount": 92000,
                  "currency": "EUR"
                },
                "by": "0.5"
              },
              "where": {
                "op": "gte",
                "left": {
                  "op": "fact",
                  "key": "person.ageYears"
                },
                "right": {
                  "op": "int",
                  "value": 18
                }
              }
            },
            "right": {
              "op": "sum",
              "over": "unit.dependents",
              "value": {
                "op": "mul",
                "operand": {
                  "op": "money",
                  "amount": 92000,
                  "currency": "EUR"
                },
                "by": "0.3"
              },
              "where": {
                "op": "lt",
                "left": {
                  "op": "fact",
                  "key": "person.ageYears"
                },
                "right": {
                  "op": "int",
                  "value": 18
                }
              }
            }
          }
        }
      },
      "sources": ["portaria-1563-2007", "dl-139-2025"]
    }
  ],
