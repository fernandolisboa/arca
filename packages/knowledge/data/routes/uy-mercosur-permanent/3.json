      "id": "mercosur-nationality",
      "title": "Holds the nationality of a Mercosur member or associated state: Argentina, Bolivia, Brazil, Chile, Colombia, Ecuador, Guyana, Paraguay, Peru, Suriname or Venezuela",
      "expression": {
        "op": "intersects",
        "list": {
          "op": "fact",
          "key": "principal.citizenships"
        },
        "set": {
