  "assessments": [
    {
      "id": "no-denial-ground",
      "title": "No charge or conviction for an intentional common crime punished with more than two years of prison, and no repeated offending, unless five years have passed since the sentence",
      "evidence": ["principal.visaRefusals"],
      "sources": ["ley-18250-denial", "decreto-45-2023-requirements"]
    },
    {
      "id": "no-entry-refusal-ground",
      "title": "No expulsion or re-entry ban in force, no conviction for trafficking, laundering or drug or arms trafficking, and no crime against humanity",
      "evidence": ["principal.visaRefusals"],
      "sources": ["ley-18250-entry-refusal", "decreto-45-2023-requirements"]
    }
  ],
