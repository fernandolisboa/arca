  "assessments": [
    {
      "id": "no-own-loss",
      "title": "The person has not lost Italian citizenship themselves: until 15 August 1992, for example by freely taking a foreign citizenship while living abroad; since then, for example by renouncing it",
      "evidence": ["principal.citizenships"],
      "sources": ["legge-555-1912-art-8", "legge-91-1992-art-11"]
    },
    {
      "id": "link-through-a-mother-before-1948",
      "title": "A link through a mother to a child born before 1 January 1948: the law of the time passed citizenship through the father, and consulates and municipalities accept a maternal link only after that date",
      "evidence": ["principal.citizenships"],
      "sources": [
        "legge-555-1912",
        "costituzione-xviii",
        "corte-cost-30-1983",
        "corte-cost-147-2026"
      ]
    },
    {
      "id": "consulate-yearly-limit",
      "title": "An adult applying through a consulate needs a place in its yearly number: until 31 December 2028, no more than the recognition procedures it concluded in 2025, and never fewer than 100",
      "evidence": ["principal.residenceCountry"],
      "sources": ["dlgs-71-2011-consulate-limit", "legge-11-2026"]
    },
    {
      "id": "minor-at-consulate",
      "title": "A minor living abroad, child of a citizen already recognized: the consulate of the district may recognize the citizenship; the yearly limit and the EUR 600 consular fee are for adults only",
      "evidence": ["principal.residenceCountry"],
      "sources": ["dlgs-71-2011-minors", "dlgs-71-2011-consulate-limit", "dlgs-71-2011-fee-table"]
    },
    {
      "id": "court-proof",
      "title": "Someone who goes to court must state and prove that no cause of non-acquisition or loss of citizenship applies; oaths and witness evidence are not admitted, save where the law provides",
      "evidence": ["principal.citizenships"],
      "sources": ["dlgs-150-2011-art-19-bis"]
    },
    {
      "id": "court-venue",
      "title": "Someone living abroad who goes to court: the case is assigned by the municipality where the Italian father, mother or ancestor was born",
      "evidence": ["principal.residenceCountry"],
      "sources": ["dl-13-2017-art-4"]
    }
  ],
