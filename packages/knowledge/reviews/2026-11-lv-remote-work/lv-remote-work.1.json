  "requirements": [
    {
      "id": "not-eu-eea-or-swiss-citizen",
      "title": "Not a citizen of an EU or EEA state or of Switzerland, Latvia included: the law's visas are for third-country nationals",
      "expression": {
        "op": "not",
        "operand": {
          "op": "intersects",
          "list": {
            "op": "fact",
            "key": "principal.citizenships"
          },
          "set": {
            "op": "set",
            "id": "eu-free-movement"
          }
        }
      },
      "sources": ["immigration-law-third-country"]
    },
    {
      "id": "not-russian",
      "title": "Not a citizen of Russia, whose citizens have no right to a visa for remote work",
      "expression": {
        "op": "not",
        "operand": {
          "op": "intersects",
          "list": {
            "op": "fact",
            "key": "principal.citizenships"
          },
          "set": {
            "op": "tokens",
            "values": ["RU"]
          }
        }
      },
      "sources": ["immigration-law-russia"]
    },
    {
      "id": "remote-work",
      "title": "Works today for an employer seated outside Latvia, the same one for at least the last 6 months; a self-employed person, contractor or business owner is possible",
      "expression": {
        "op": "any",
        "operands": [
          {
            "op": "some",
            "over": "principal.workPeriods",
            "where": {
              "op": "all",
              "operands": [
                {
                  "op": "eq",
                  "left": {
                    "op": "fact",
                    "key": "workPeriod.relation"
                  },
                  "right": {
                    "op": "token",
                    "value": "employee"
                  }
                },
                {
                  "op": "ne",
                  "left": {
                    "op": "fact",
                    "key": "workPeriod.employerCountry"
                  },
                  "right": {
                    "op": "token",
                    "value": "LV"
                  }
                },
                {
                  "op": "since",
                  "date": {
                    "op": "fact",
                    "key": "workPeriod.start"
                  },
                  "duration": "P6M"
                },
                {
                  "op": "not",
                  "operand": {
                    "op": "since",
                    "date": {
                      "op": "fact",
                      "key": "workPeriod.end"
                    },
                    "duration": "P1D"
                  }
                }
              ]
            }
          },
          {
            "op": "all",
            "operands": [
              {
                "op": "some",
                "over": "principal.workPeriods",
                "where": {
                  "op": "all",
                  "operands": [
                    {
                      "op": "in",
                      "item": {
                        "op": "fact",
                        "key": "workPeriod.relation"
                      },
                      "set": {
                        "op": "tokens",
                        "values": ["contractor", "self_employed", "owner"]
                      }
                    },
                    {
                      "op": "not",
                      "operand": {
                        "op": "since",
                        "date": {
                          "op": "fact",
                          "key": "workPeriod.end"
                        },
                        "duration": "P1D"
                      }
                    }
                  ]
                }
              },
              {
                "op": "unmodeled"
              }
            ]
          }
        ]
      },
      "sources": [
        "immigration-law-remote-work",
        "visa-regulations",
        "immigration-law-earlier-regulations"
      ]
    }
  ],
  "assessments": [
    {
      "id": "oecd-registration",
      "title": "The employer is registered in an OECD member state other than Latvia; a self-employed person is registered as such in an OECD member state",
