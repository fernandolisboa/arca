      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "biological"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 18
            }
          },
          {
            "op": "not",
