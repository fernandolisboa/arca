    {
      "id": "not-nordic-eu-eea-or-swiss-citizen",
      "title": "Not a citizen of Denmark, another Nordic country, an EU or EEA state or Switzerland: they live and work in Denmark without this permit",
      "expression": {
        "op": "not",
        "operand": {
          "op": "intersects",
          "list": {
            "op": "fact",
            "key": "principal.citizenships"
          },
          "set": {
            "op": "set",
            "id": "eu-free-movement"
          }
        }
      },
      "sources": ["aliens-act-free-movement", "eu-residence-order"]
    }
