  "assessments": [
    {
      "id": "pay-limit",
      "title": "A job offer in Denmark with annual pay of at least the pay limit: DKK 400,000 in the act, adjusted each year for wage growth; DKK 552,000 for 2026 as SIRI publishes it",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["aliens-act-pay-limit", "siri-pay-limit"]
    },
    {
      "id": "working-hours",
      "title": "Employment of at least 30 hours a week",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["aliens-act-employment-terms", "siri-pay-limit"]
    },
    {
      "id": "danish-bank-account",
      "title": "Pay goes into a Danish bank account in the principal's own name, opened within 180 days of entry or of the permit by someone who does not yet hold a permit of at least 180 days",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["aliens-act-employment-terms", "siri-pay-limit"]
    },
    {
      "id": "usual-terms",
      "title": "Pay and employment terms not inferior to the Danish standards of the professional field",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["siri-pay-limit"]
    },
    {
      "id": "genuine-offer",
      "title": "No permit for a job in a lawful labour dispute, where the actual employment is presumed not to match the application nor meet the conditions, or where the offer mainly serves to obtain residence",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["aliens-act-employment-terms"]
    },
    {
      "id": "no-social-assistance",
      "title": "Neither the principal nor the family members with permits through them receive assistance under the Active Social Policy Act",
      "evidence": ["unit.liquidAssets"],
      "sources": ["aliens-act-social-assistance"]
    },
    {
      "id": "shared-home",
      "title": "Family members live at the same address as the principal and receive no assistance under the Active Social Policy Act",
      "evidence": ["unit.liquidAssets"],
      "sources": ["aliens-act-family", "siri-accompanying-family"]
    },
    {
      "id": "danish-authorisation",
      "title": "Where the job needs a Danish authorisation, such as a doctor's, the authorisation, or a temporary one for adaptation and training, held before the permit is granted",
      "evidence": ["principal.educationLevel"],
      "sources": ["siri-conditions"]
    },
    {
      "id": "family-permits-not-revoked",
      "title": "The permit is conditional on no family member with a permit through the principal having that permit revoked more than once for lack of a required work permit",
      "evidence": ["principal.hasSpouse"],
      "sources": ["aliens-act-revocations", "siri-conditions"]
    },
    {
      "id": "recognised-union",
      "title": "A spouse's marriage or registered partnership must be one Danish law recognises: legal where made, both present and 18 or more then, not of convenience, not against fundamental legal principles",
      "evidence": ["principal.hasSpouse"],
      "sources": ["siri-recognised-union"]
    },
    {
      "id": "danish-employer",
      "title": "As a general rule, the employment agreement is with a company registered in Denmark; exceptions exist, such as a foreign company providing services in Denmark",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["siri-danish-employer"]
    },
    {
      "id": "custody-consent",
      "title": "A child coming with only one of two parents who share custody needs the other parent's consent; a parent with sole custody documents it",
      "evidence": ["principal.hasSpouse"],
      "sources": ["siri-custody-consent"]
    }
  ],
  "dependents": [
