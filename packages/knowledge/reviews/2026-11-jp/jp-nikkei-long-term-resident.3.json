  ],
  "countrySets": [],
  "requirements": [
    {
      "id": "japanese-descent",
      "title": "A biological grandchild of a Japanese national: the parent was born while the grandparent was Japanese, or the grandparent, born to a Japanese national, was once Japanese with a register in Japan",
      "expression": {
        "op": "any",
        "operands": [
          {
            "op": "some",
            "over": "principal.ancestors",
            "generations": 2,
            "where": {
              "op": "all",
              "operands": [
                {
                  "op": "gt",
                  "left": {
                    "op": "fact",
                    "key": "lineage.generation"
                  },
                  "right": {
                    "op": "int",
                    "value": 1
                  }
                },
                {
                  "op": "eq",
                  "left": {
                    "op": "fact",
                    "key": "lineage.edgeKind"
                  },
                  "right": {
                    "op": "token",
                    "value": "biological"
                  }
                },
                {
                  "op": "intersects",
                  "list": {
                    "op": "fact",
                    "key": "lineage.citizenshipsAtChildBirth"
                  },
                  "set": {
                    "op": "tokens",
                    "values": ["JP"]
                  }
                },
                {
                  "op": "every",
                  "over": "lineage.links",
                  "where": {
                    "op": "eq",
                    "left": {
                      "op": "fact",
                      "key": "lineage.edgeKind"
                    },
                    "right": {
                      "op": "token",
                      "value": "biological"
                    }
                  }
                }
              ]
            }
          },
          {
            "op": "some",
            "over": "principal.ancestors",
            "generations": 3,
            "where": {
              "op": "all",
              "operands": [
                {
                  "op": "gt",
                  "left": {
                    "op": "fact",
                    "key": "lineage.generation"
                  },
                  "right": {
                    "op": "int",
                    "value": 1
                  }
                },
                {
                  "op": "eq",
                  "left": {
                    "op": "fact",
                    "key": "lineage.edgeKind"
                  },
                  "right": {
                    "op": "token",
                    "value": "biological"
                  }
                },
                {
                  "op": "intersects",
                  "list": {
                    "op": "fact",
                    "key": "lineage.citizenshipsAtChildBirth"
                  },
                  "set": {
                    "op": "tokens",
                    "values": ["JP"]
                  }
                },
                {
                  "op": "every",
                  "over": "lineage.links",
                  "where": {
                    "op": "eq",
                    "left": {
                      "op": "fact",
                      "key": "lineage.edgeKind"
                    },
                    "right": {
                      "op": "token",
                      "value": "biological"
                    }
                  }
                },
                {
                  "op": "unmodeled"
                }
              ]
            }
          }
        ]
      },
      "sources": ["teijusha-notice", "immigration-act-landing"]
    },
    {
      "id": "not-japanese-national",
      "title": "Not a Japanese national: statuses of residence are only for foreigners, who hold no Japanese nationality",
      "expression": {
        "op": "not",
        "operand": {
          "op": "intersects",
          "list": {
            "op": "fact",
            "key": "principal.citizenships"
          },
          "set": {
            "op": "tokens",
            "values": ["JP"]
          }
        }
      },
      "sources": ["immigration-act-foreigner"]
    }
  ],
  "assessments": [
    {
      "id": "good-conduct",
      "title": "Good conduct, and none of the grounds for refusing landing (criminal record, earlier deportation and the others in art. 5 of the act)",
      "evidence": ["principal.visaRefusals"],
      "sources": ["teijusha-notice", "immigration-act-denial"]
    },
    {
      "id": "family-conditions",
      "title": "If family come: a lawful spouse; each child's supporter, and for the spouse's child also the spouse, holds a stay of a year or more; spouse and biological children of good conduct",
      "evidence": ["principal.hasSpouse"],
      "sources": ["teijusha-notice"]
    },
    {
      "id": "extension-documents",
      "title": "Papers for each extension of stay: family status documents, proof of income and tax paid (or, without income, the supporter's job and income), and a guarantor living in Japan",
      "evidence": ["unit.liquidAssets"],
      "sources": ["enforcement-ordinance-documents"]
    },
    {
      "id": "extension-conditions",
      "title": "Each extension weighs: still fitting the notice (an age or support that later lapses does not alone bar it), good conduct, a self-supporting household, no long absence abroad without good reason",
      "evidence": ["unit.liquidAssets"],
      "sources": ["extension-guideline", "teijusha-notice"]
    },
    {
      "id": "extension-obligations",
      "title": "Each extension also weighs: work on terms that meet labour law; taxes paid; statutory payments such as health insurance paid (serious arrears count against); residence card and other notices filed",
      "evidence": ["unit.liquidAssets"],
      "sources": ["extension-guideline"]
    },
    {
      "id": "landing-documents",
      "title": "Papers to land, for a certificate of eligibility or to change to this status: family status documents, proof of means for the whole stay and a guarantor living in Japan",
      "evidence": ["unit.liquidAssets"],
      "sources": ["enforcement-ordinance-documents"]
    }
  ],
  "dependents": [
    {
      "id": "spouse",
      "title": "Spouse",
      "path": ["spouse"],
      "condition": {
        "op": "bool",
        "value": true
      },
      "sources": ["teijusha-notice"]
    },
    {
      "id": "children",
      "title": "Unmarried biological children under 18 whom the principal supports",
      "path": ["child"],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "biological"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 18
            }
          },
          {
            "op": "not",
            "operand": {
              "op": "fact",
              "key": "person.hasSpouse"
            }
          },
          {
            "op": "fact",
            "key": "person.dependsOnPrincipal"
          }
        ]
      },
      "sources": ["teijusha-notice", "civil-code-majority"]
    },
    {
      "id": "adopted-children",
      "title": "Adopted children under 6 whom the principal supports",
      "path": ["child"],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "adoptive"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 6
            }
          },
          {
            "op": "fact",
            "key": "person.dependsOnPrincipal"
          }
        ]
      },
      "sources": ["teijusha-notice"]
    },
    {
      "id": "spouse-children",
      "title": "The spouse's unmarried biological children under 18 whom the principal or the spouse supports",
      "path": ["spouse", "child"],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "biological"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 18
            }
          },
          {
            "op": "not",
            "operand": {
              "op": "fact",
              "key": "person.hasSpouse"
            }
          },
          {
            "op": "any",
            "operands": [
              {
                "op": "fact",
                "key": "person.dependsOnPrincipal"
              },
              {
                "op": "fact",
                "key": "edge.dependsOnLinkedPerson"
              }
            ]
          }
        ]
      },
      "sources": ["teijusha-notice", "civil-code-majority"]
    },
    {
      "id": "spouse-adopted-children",
      "title": "The spouse's adopted children under 6 whom the principal or the spouse supports",
      "path": ["spouse", "child"],
      "condition": {
        "op": "all",
        "operands": [
          {
            "op": "eq",
            "left": {
              "op": "fact",
              "key": "edge.parentKind"
            },
            "right": {
              "op": "token",
              "value": "adoptive"
            }
          },
          {
            "op": "lt",
            "left": {
              "op": "fact",
              "key": "person.ageYears"
            },
            "right": {
              "op": "int",
              "value": 6
            }
          },
          {
            "op": "any",
            "operands": [
              {
                "op": "fact",
                "key": "person.dependsOnPrincipal"
              },
              {
                "op": "fact",
                "key": "edge.dependsOnLinkedPerson"
              }
            ]
          }
        ]
      },
      "sources": ["teijusha-notice"]
    }
  ],
  "costs": [
    {
      "id": "extension-fee",
      "title": "Fee for each change of status to, or extension of, the principal's stay, by the period granted: JPY 18,000 for 6 months, 33,000 for 1 year, 64,000 for 3 years, 75,000 for 5 years (shown), less online",
