    },
    {
      "id": "extension-fee-dependents",
      "title": "Fee for each change of status to, or extension of, a relative's stay, by the period granted: JPY 18,000 for 6 months, 33,000 for 1 year, 64,000 for 3 years, 75,000 for 5 years (shown), less online",
      "kind": "fee",
      "amount": {
        "op": "money",
        "amount": 75000,
        "currency": "JPY"
      },
      "appliesTo": "each_dependent",
      "condition": {
        "op": "unmodeled"
      },
      "sources": ["stay-fees-leaflet", "stay-fees-order"]
    }
  ],
  "durations": [
    {
      "id": "period-of-stay",
      "title": "Period of stay as a long-term resident (teijusha) of a status the notice sets: 5 years, 3 years, 1 year or 6 months",
      "min": "P6M",
      "max": "P60M",
      "sources": ["enforcement-ordinance-periods"]
    }
  ]
