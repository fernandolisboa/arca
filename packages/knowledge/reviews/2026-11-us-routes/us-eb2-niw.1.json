  "assessments": [
    {
      "id": "advanced-degree-or-exceptional-ability",
      "title": "A professional with a U.S. advanced degree or foreign equivalent (a bachelor's plus 5 years' progressive experience after it counts; a doctorate if the field requires one), or exceptional ability",
      "evidence": ["principal.educationLevel"],
      "sources": ["usc-1153-eb2", "cfr-204-5-k"]
    },
    {
      "id": "exceptional-ability",
      "title": "Exceptional ability, if claimed: expertise well above the ordinary in the sciences, arts or business, shown by 3 of 6 kinds of evidence or comparable evidence; a degree or license alone is not enough",
      "evidence": ["principal.educationLevel", "principal.monthlyActiveIncome"],
      "sources": ["usc-1153-exceptional", "cfr-204-5-k"]
    },
    {
      "id": "national-interest",
      "title": "Waiving the job offer, and with it the labor certification, is in the national interest of the United States, as the agency deems it",
      "evidence": ["principal.educationLevel"],
      "sources": ["usc-1153-eb2", "cfr-204-5-k"]
    }
  ],
