  "assessments": [
    {
      "id": "employment-abroad",
      "title": "Employed abroad full time 1 continuous year in the last 3 years by the company, its parent, branch, affiliate or subsidiary, as manager, executive or specialist (manager or executive if a new office)",
      "evidence": ["principal.monthlyActiveIncome", "principal.residenceCountry"],
      "sources": ["usc-1101-l", "cfr-214-2-l"]
    },
    {
      "id": "qualifying-organization",
      "title": "The U.S. and foreign employers are the same company or its parent, branch, affiliate or subsidiary, and do business in the U.S. and at least one other country for the whole stay",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["cfr-214-2-l", "usc-1101-l"]
    },
    {
      "id": "managerial-or-executive-role",
      "title": "The U.S. job is primarily managerial (managing the organization or a function, supervising professionals or managers) or executive (directing its management, setting goals and policies)",
      "evidence": ["principal.monthlyActiveIncome"],
      "sources": ["usc-1101-capacity", "cfr-214-2-l"]
    },
    {
      "id": "new-office-plan",
      "title": "For a new office (doing business in the U.S. for less than a year): premises secured, and within a year of approval the office will support a managerial or executive job",
      "evidence": ["unit.liquidAssets"],
      "sources": ["cfr-214-2-l"]
    },
    {
      "id": "new-office-investment",
      "title": "For a new office: the size of the U.S. investment, and the foreign company's financial ability to pay the transferee and to start doing business in the U.S.",
      "evidence": ["unit.liquidAssets"],
      "sources": ["cfr-214-2-l"]
    }
  ],
