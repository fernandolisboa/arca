{
  "name": "@arca/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "default": "./dist/routes/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi:write": "node scripts/write-openapi.ts"
  },
  "devDependencies": {
    "@arca/eslint-config": "workspace:*",
    "@arca/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  }
}
