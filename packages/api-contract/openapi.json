{
  "openapi": "3.1.0",
  "info": {
    "title": "Arca API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health, including the database connection and its role",
        "responses": {
          "200": {
            "description": "Current health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "unavailable",
                            "wrong_role"
                          ]
                        }
                      },
                      "required": [
                        "database"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/session": {
      "get": {
        "operationId": "getSession",
        "summary": "The signed-in account and the device of this session; 401 without a session",
        "responses": {
          "200": {
            "description": "The current session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accountId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "device": {
                      "type": "object",
                      "properties": {
                        "browser": {
                          "type": "string",
                          "enum": [
                            "edge",
                            "samsung_internet",
                            "opera",
                            "firefox",
                            "chrome",
                            "safari",
                            "other"
                          ]
                        },
                        "os": {
                          "type": "string",
                          "enum": [
                            "ios",
                            "ipados",
                            "android",
                            "chromeos",
                            "windows",
                            "macos",
                            "linux",
                            "other"
                          ]
                        }
                      },
                      "required": [
                        "browser",
                        "os"
                      ]
                    }
                  },
                  "required": [
                    "accountId",
                    "email",
                    "device"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "summary": "Ends this session and clears its cookies",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed out",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/passkey/generate-authenticate-options": {
      "get": {
        "operationId": "passkeySignInOptions",
        "summary": "Options for a passkey sign-in, with a single-use challenge in a cookie",
        "responses": {
          "200": {
            "description": "Request options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challenge": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]*$"
                    },
                    "timeout": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "rpId": {
                      "type": "string"
                    },
                    "allowCredentials": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "public-key"
                            ]
                          },
                          "transports": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "type"
                        ]
                      }
                    },
                    "userVerification": {
                      "type": "string",
                      "enum": [
                        "required"
                      ]
                    },
                    "extensions": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "challenge",
                    "userVerification"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/passkey/verify-authentication": {
      "post": {
        "operationId": "passkeySignIn",
        "summary": "Signs in with a passkey assertion and sets the session cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "response": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]*$"
                      },
                      "rawId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]*$"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "public-key"
                        ]
                      },
                      "response": {
                        "type": "object",
                        "properties": {
                          "clientDataJSON": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "authenticatorData": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "signature": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "userHandle": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          }
                        },
                        "required": [
                          "clientDataJSON",
                          "authenticatorData",
                          "signature"
                        ]
                      },
                      "authenticatorAttachment": {
                        "type": "string",
                        "enum": [
                          "platform",
                          "cross-platform"
                        ]
                      },
                      "clientExtensionResults": {
                        "type": "object",
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "id",
                      "rawId",
                      "type",
                      "response",
                      "clientExtensionResults"
                    ]
                  }
                },
                "required": [
                  "response"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/step-up/options": {
      "post": {
        "operationId": "stepUpOptions",
        "summary": "Options for a step-up bound to a purpose and an action, valid for 2 minutes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "purpose": {
                        "type": "string",
                        "enum": [
                          "vault_unlock"
                        ]
                      }
                    },
                    "required": [
                      "purpose"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "purpose": {
                        "type": "string",
                        "enum": [
                          "sensitive_settings",
                          "account_deletion",
                          "data_export",
                          "financial_action",
                          "vault_write"
                        ]
                      },
                      "target": {
                        "type": "object",
                        "properties": {
                          "action": {
                            "type": "string",
                            "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
                          },
                          "targets": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "maxItems": 32
                          },
                          "fields": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string",
                              "maxLength": 4096
                            }
                          },
                          "nonce": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
                          }
                        },
                        "required": [
                          "action",
                          "targets",
                          "nonce"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "purpose",
                      "target"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request options and their challenge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challengeId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "options": {
                      "type": "object",
                      "properties": {
                        "challenge": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]*$"
                        },
                        "timeout": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "rpId": {
                          "type": "string"
                        },
                        "allowCredentials": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_-]*$"
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "public-key"
                                ]
                              },
                              "transports": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "required": [
                              "id",
                              "type"
                            ]
                          }
                        },
                        "userVerification": {
                          "type": "string",
                          "enum": [
                            "required"
                          ]
                        },
                        "extensions": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "challenge",
                        "userVerification"
                      ]
                    }
                  },
                  "required": [
                    "challengeId",
                    "options"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/step-up/verify": {
      "post": {
        "operationId": "stepUpVerify",
        "summary": "Verifies a step-up assertion; the approved action may then run once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "challengeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "response": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]*$"
                      },
                      "rawId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]*$"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "public-key"
                        ]
                      },
                      "response": {
                        "type": "object",
                        "properties": {
                          "clientDataJSON": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "authenticatorData": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "signature": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "userHandle": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          }
                        },
                        "required": [
                          "clientDataJSON",
                          "authenticatorData",
                          "signature"
                        ]
                      },
                      "authenticatorAttachment": {
                        "type": "string",
                        "enum": [
                          "platform",
                          "cross-platform"
                        ]
                      },
                      "clientExtensionResults": {
                        "type": "object",
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "id",
                      "rawId",
                      "type",
                      "response",
                      "clientExtensionResults"
                    ]
                  }
                },
                "required": [
                  "challengeId",
                  "response"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Step-up verified",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/enroll-owner": {
      "post": {
        "operationId": "enrollOwner",
        "summary": "Emails a registration link to the first account; 404 once an account exists or the code is not the configured one",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email"
                  }
                },
                "required": [
                  "code",
                  "email"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Link sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/registration/options": {
      "post": {
        "operationId": "registrationOptions",
        "summary": "Options for registering a link's passkey, with a single-use challenge in a cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Creation options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challenge": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]*$"
                    },
                    "rp": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]*$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "displayName"
                      ]
                    },
                    "pubKeyCredParams": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "public-key"
                            ]
                          },
                          "alg": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "type",
                          "alg"
                        ]
                      }
                    },
                    "timeout": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "excludeCredentials": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]*$"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "public-key"
                            ]
                          },
                          "transports": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "type"
                        ]
                      }
                    },
                    "authenticatorSelection": {
                      "type": "object",
                      "properties": {
                        "authenticatorAttachment": {
                          "type": "string",
                          "enum": [
                            "platform",
                            "cross-platform"
                          ]
                        },
                        "residentKey": {
                          "type": "string",
                          "enum": [
                            "required"
                          ]
                        },
                        "requireResidentKey": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "userVerification": {
                          "type": "string",
                          "enum": [
                            "required"
                          ]
                        }
                      },
                      "required": [
                        "residentKey",
                        "requireResidentKey",
                        "userVerification"
                      ]
                    },
                    "attestation": {
                      "type": "string",
                      "enum": [
                        "none"
                      ]
                    },
                    "extensions": {
                      "type": "object",
                      "properties": {
                        "prf": {
                          "type": "object",
                          "properties": {},
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "prf"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "challenge",
                    "rp",
                    "user",
                    "pubKeyCredParams",
                    "authenticatorSelection",
                    "extensions"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,64}$"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/registration/verify": {
      "post": {
        "operationId": "registrationVerify",
        "summary": "Registers the link's passkey, creating its account and signing it in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "response": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
