    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "correction_request",
        "name": "correction_request_target",
        "value": "CASE WHEN \"item_kind\" = 'newRoute'\n        THEN \"route_id\" IS NULL AND \"version_number\" IS NULL\n          AND \"country_code\" ~ '^[a-z]{2}$'\n        ELSE \"route_id\" IS NOT NULL AND \"version_number\" IS NOT NULL\n          AND \"country_code\" IS NULL END",
        "entityType": "checks"
      }
    },
    {
      "op": "alter",
      "key": "columns\u0000[\"knowledge\",\"correction_request\",\"route_id\"]",
      "set": {
        "notNull": false
      }
    },
    {
      "op": "alter",
      "key": "columns\u0000[\"knowledge\",\"correction_request\",\"version_number\"]",
      "set": {
        "notNull": false
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"knowledge\",\"correction_request\",\"correction_request_item_kind\"]",
      "set": {
        "value": "\"item_kind\" IN ('newRoute', 'version', 'settings', 'requirement', 'assessment', 'dependent', 'cost', 'duration', 'countrySet')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"knowledge\",\"correction_request\",\"correction_request_item_key\"]",
      "set": {
        "value": "CASE WHEN \"item_kind\" IN ('newRoute', 'version', 'settings') THEN \"item_key\" IS NULL\n        ELSE \"item_key\" ~ '^[a-z0-9][a-z0-9./-]{0,79}$' END"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"knowledge\",\"correction_source\",\"correction_source_position_range\"]",
      "set": {
        "value": "\"position\" BETWEEN 0 AND 19"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"knowledge\",\"correction_source\",\"correction_source_shape\"]",
      "set": {
        "value": "CASE \"kind\"\n        WHEN 'link' THEN \"text\" IS NULL AND \"upload_id\" IS NULL\n          AND \"page_url\" IS NULL\n          AND \"url\" ~ '^https://[^[:space:]]+$' AND char_length(\"url\") <= 2048\n        WHEN 'text' THEN \"upload_id\" IS NULL\n          AND \"page_url\" IS NULL AND char_length(\"text\") BETWEEN 1 AND 20000\n          AND (\"url\" IS NULL OR (\"url\" ~ '^https://[^[:space:]]+$'\n            AND char_length(\"url\") <= 2048))\n        WHEN 'file' THEN \"url\" IS NULL AND \"text\" IS NULL\n          AND \"upload_id\" IS NOT NULL\n          AND (\"page_url\" IS NULL OR (\"page_url\" ~ '^https://[^[:space:]]+$'\n            AND char_length(\"page_url\") <= 2048))\n        ELSE false END"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"knowledge\",\"correction_event\",\"correction_event_shape\"]",
      "set": {
        "value": "CASE \"kind\"\n        WHEN 'closed' THEN \"corrector_key_id\" IS NULL AND \"proposed_version\" IS NULL\n          AND \"explanation\" IS NULL AND \"proposed_route_id\" IS NULL\n        WHEN 'taken' THEN \"corrector_key_id\" IS NOT NULL AND \"proposed_version\" IS NULL\n          AND \"explanation\" IS NULL AND \"proposed_route_id\" IS NULL\n        WHEN 'answered' THEN \"corrector_key_id\" IS NOT NULL\n          AND (\"proposed_version\" IS NULL) <> (\"explanation\" IS NULL)\n          AND (\"proposed_route_id\" IS NULL OR (\"proposed_version\" IS NOT NULL\n            AND \"proposed_route_id\" ~ '^[a-z]{2}-[a-z0-9][a-z0-9-]{0,62}$'))\n          AND coalesce(\"proposed_version\" > 0, true)\n          AND coalesce(char_length(\"explanation\") BETWEEN 1 AND 2000, true)\n        ELSE false END"
      }
    }
  ]
