    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "admin_grant",
        "name": "admin_grant_kind",
        "value": "\"kind\" IN ('grant', 'removal')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "admin_grant",
        "name": "admin_grant_actor_basis",
        "value": "CASE \"actor_basis\" WHEN 'owner_list' THEN \"actor_grant_id\" IS NULL\n        WHEN 'grant' THEN \"actor_grant_id\" IS NOT NULL ELSE false END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "admin_grant",
        "name": "admin_grant_shape",
        "value": "CASE \"kind\"\n        WHEN 'grant' THEN \"step_up_id\" IS NOT NULL AND \"removes_grant_id\" IS NULL\n          AND \"grantee_account_id\" <> \"actor_account_id\"\n        WHEN 'removal' THEN \"step_up_id\" IS NULL AND \"removes_grant_id\" IS NOT NULL\n        ELSE false END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "admin_grant",
        "name": "admin_grant_insert_by_admin",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "app_auth"
        ],
        "using": null,
        "withCheck": "\"knowledge\".\"admin_grant\".\"actor_account_id\" = nullif(current_setting('app.account_id', true), '')::uuid\n        AND (\"knowledge\".\"admin_grant\".\"actor_basis\" = 'owner_list' OR EXISTS (SELECT FROM \"knowledge\".\"admin_grant\" \"given\"\n        WHERE \"given\".\"id\" = \"knowledge\".\"admin_grant\".\"actor_grant_id\" AND \"given\".\"kind\" = 'grant'\n          AND \"given\".\"grantee_account_id\" = \"knowledge\".\"admin_grant\".\"actor_account_id\"))\n        AND CASE \"knowledge\".\"admin_grant\".\"kind\"\n          WHEN 'grant' THEN EXISTS (SELECT FROM \"auth\".\"step_up\"\n            WHERE \"auth\".\"step_up\".\"id\" = \"knowledge\".\"admin_grant\".\"step_up_id\"\n              AND \"auth\".\"step_up\".\"account_id\" = \"knowledge\".\"admin_grant\".\"actor_account_id\"\n              AND \"auth\".\"step_up\".\"purpose\" = 'admin_grant'\n              AND \"auth\".\"step_up\".\"consumed_at\" IS NOT NULL)\n          WHEN 'removal' THEN EXISTS (SELECT FROM \"knowledge\".\"admin_grant\" \"given\"\n        WHERE \"given\".\"id\" = \"knowledge\".\"admin_grant\".\"removes_grant_id\" AND \"given\".\"kind\" = 'grant'\n          AND \"given\".\"grantee_account_id\" = \"knowledge\".\"admin_grant\".\"grantee_account_id\")\n          ELSE false END",
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "admin_grant",
        "name": "admin_grant_read_auth",
        "as": "PERMISSIVE",
        "for": "SELECT",
        "roles": [
          "app_auth"
        ],
        "using": "true",
        "withCheck": null,
        "entityType": "policies"
      }
