    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "decision",
        "name": "decision_insert_spent_step_up",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "app_auth"
        ],
        "using": null,
        "withCheck": "EXISTS (SELECT FROM \"auth\".\"step_up\"\n        WHERE \"auth\".\"step_up\".\"id\" = \"knowledge\".\"decision\".\"step_up_id\"\n          AND \"auth\".\"step_up\".\"account_id\" = \"knowledge\".\"decision\".\"approver_account_id\"\n          AND \"auth\".\"step_up\".\"purpose\" = 'knowledge_decision'\n          AND \"auth\".\"step_up\".\"consumed_at\" IS NOT NULL\n          AND \"auth\".\"step_up\".\"credential_id\" = \"knowledge\".\"decision\".\"credential_id\"\n          AND \"auth\".\"step_up\".\"nonce\" = \"knowledge\".\"decision\".\"server_nonce\"\n          AND \"auth\".\"step_up\".\"authenticator_data\" = \"knowledge\".\"decision\".\"authenticator_data\"\n          AND \"auth\".\"step_up\".\"client_data_json\" = \"knowledge\".\"decision\".\"client_data_json\"\n          AND \"auth\".\"step_up\".\"signature\" = \"knowledge\".\"decision\".\"signature\")",
        "entityType": "policies"
      }
    },
