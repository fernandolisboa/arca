    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "ai_key",
        "name": "ai_key_provider",
        "value": "\"provider\" IN ('anthropic', 'typesafe')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "ai_key",
        "name": "ai_key_shape",
        "value": "CASE \"kind\"\n        WHEN 'set' THEN octet_length(\"ciphertext\") BETWEEN 1 AND 1024\n          AND octet_length(\"nonce\") = 12 AND octet_length(\"tag\") = 16\n          AND \"kek_version\" > 0 AND \"format_version\" = 1\n          AND char_length(\"last_four\") = 4 AND \"removes_key_id\" IS NULL\n        WHEN 'removed' THEN \"ciphertext\" IS NULL AND \"nonce\" IS NULL\n          AND \"tag\" IS NULL AND \"kek_version\" IS NULL\n          AND \"format_version\" IS NULL AND \"last_four\" IS NULL\n          AND \"removes_key_id\" IS NOT NULL\n        ELSE false END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "ai_stage_setting",
        "name": "ai_stage_setting_stage",
        "value": "\"stage\" IN ('research', 'validation', 'correction')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "ai_stage_setting",
        "name": "ai_stage_setting_model_format",
        "value": "\"model\" ~ '^[a-z0-9][a-z0-9.-]{0,63}$'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "ai_stage_setting",
        "name": "ai_stage_setting_effort",
        "value": "\"effort\" IS NULL OR \"effort\" IN ('low', 'medium', 'high', 'xhigh', 'max')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "ai_key",
        "name": "ai_key_insert_with_step_up",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "app_auth"
        ],
        "using": null,
        "withCheck": "\"knowledge\".\"ai_key\".\"actor_account_id\" = nullif(current_setting('app.account_id', true), '')::uuid\n        AND EXISTS (SELECT FROM \"auth\".\"step_up\"\n          WHERE \"auth\".\"step_up\".\"id\" = \"knowledge\".\"ai_key\".\"step_up_id\"\n            AND \"auth\".\"step_up\".\"account_id\" = \"knowledge\".\"ai_key\".\"actor_account_id\"\n            AND \"auth\".\"step_up\".\"purpose\" = 'ai_key'\n            AND \"auth\".\"step_up\".\"consumed_at\" IS NOT NULL)",
        "entityType": "policies"
      }
    },
