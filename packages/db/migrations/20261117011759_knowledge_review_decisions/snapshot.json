    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "decision",
        "name": "decision_insert_with_step_up",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "app_auth"
        ],
        "using": null,
        "withCheck": "\"knowledge\".\"decision\".\"proof\" = 'admin_step_up' AND \"knowledge\".\"decision\".\"approver_account_id\" = nullif(current_setting('app.account_id', true), '')::uuid\n        AND (\"knowledge\".\"decision\".\"admin_basis\" = 'owner_list'\n          OR EXISTS (SELECT FROM \"knowledge\".\"admin_grant\" \"given\"\n        WHERE \"given\".\"id\" = \"knowledge\".\"decision\".\"admin_grant_id\" AND \"given\".\"kind\" = 'grant'\n          AND \"given\".\"grantee_account_id\" = \"knowledge\".\"decision\".\"approver_account_id\"))\n        AND EXISTS (SELECT FROM \"auth\".\"step_up\"\n          WHERE \"auth\".\"step_up\".\"id\" = \"knowledge\".\"decision\".\"step_up_id\"\n            AND \"auth\".\"step_up\".\"account_id\" = \"knowledge\".\"decision\".\"approver_account_id\"\n            AND \"auth\".\"step_up\".\"purpose\" = 'knowledge_decision'\n            AND \"auth\".\"step_up\".\"consumed_at\" IS NOT NULL\n            AND \"auth\".\"step_up\".\"credential_id\" = \"knowledge\".\"decision\".\"credential_id\"\n            AND \"auth\".\"step_up\".\"nonce\" = \"knowledge\".\"decision\".\"server_nonce\"\n            AND \"auth\".\"step_up\".\"authenticator_data\" = \"knowledge\".\"decision\".\"authenticator_data\"\n            AND \"auth\".\"step_up\".\"client_data_json\" = \"knowledge\".\"decision\".\"client_data_json\"\n            AND \"auth\".\"step_up\".\"signature\" = \"knowledge\".\"decision\".\"signature\")",
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "route_version",
        "name": "route_version_insert_proposal",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "app_jobs"
        ],
        "using": null,
        "withCheck": "EXISTS (SELECT FROM \"knowledge\".\"update_end\" \"ended\"\n          JOIN \"knowledge\".\"update_request\" \"asked\" ON \"asked\".\"id\" = \"ended\".\"request_id\"\n        WHERE \"ended\".\"request_id\" = \"knowledge\".\"route_version\".\"request_id\" AND \"ended\".\"failure\" IS NULL\n          AND \"ended\".\"content_hash\" = \"knowledge\".\"route_version\".\"content_hash\"\n          AND \"asked\".\"route_id\" = \"knowledge\".\"route_version\".\"route_id\")",
        "entityType": "policies"
      }
    },
