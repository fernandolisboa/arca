    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "decision",
        "name": "decision_proof",
        "value": "CASE \"proof\"\n        WHEN 'step_up' THEN \"admin_basis\" IS NULL\n          AND \"credential_id\" IS NOT NULL AND \"public_key\" IS NOT NULL\n          AND \"action_nonce\" IS NOT NULL AND \"server_nonce\" IS NOT NULL\n          AND \"authenticator_data\" IS NOT NULL AND \"client_data_json\" IS NOT NULL\n          AND \"signature\" IS NOT NULL AND \"step_up_id\" IS NOT NULL\n        WHEN 'session' THEN \"admin_basis\" IS NOT DISTINCT FROM 'owner_list'\n          AND \"credential_id\" IS NULL AND \"public_key\" IS NULL\n          AND \"action_nonce\" IS NULL AND \"server_nonce\" IS NULL\n          AND \"authenticator_data\" IS NULL AND \"client_data_json\" IS NULL\n          AND \"signature\" IS NULL AND \"step_up_id\" IS NULL\n        ELSE false END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "decision",
        "name": "decision_insert_session",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "app_auth"
        ],
        "using": null,
        "withCheck": "\"knowledge\".\"decision\".\"proof\" = 'session'\n        AND \"knowledge\".\"decision\".\"approver_account_id\" = nullif(current_setting('app.account_id', true), '')::uuid",
        "entityType": "policies"
      }
    },
