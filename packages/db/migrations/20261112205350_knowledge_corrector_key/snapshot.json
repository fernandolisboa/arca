    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "correction_event",
        "name": "correction_event_shape",
        "value": "CASE \"kind\"\n        WHEN 'closed' THEN \"corrector_key_id\" IS NULL AND \"proposed_version\" IS NULL\n          AND \"explanation\" IS NULL\n        WHEN 'taken' THEN \"corrector_key_id\" IS NOT NULL AND \"proposed_version\" IS NULL\n          AND \"explanation\" IS NULL\n        WHEN 'answered' THEN \"corrector_key_id\" IS NOT NULL\n          AND (\"proposed_version\" IS NULL) <> (\"explanation\" IS NULL)\n          AND coalesce(\"proposed_version\" > 0, true)\n          AND coalesce(char_length(\"explanation\") BETWEEN 1 AND 2000, true)\n        ELSE false END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "corrector_key",
        "name": "corrector_key_shape",
        "value": "CASE \"kind\"\n        WHEN 'created' THEN octet_length(\"key_sha256\") = 32 AND \"step_up_id\" IS NOT NULL\n          AND \"revokes_key_id\" IS NULL\n        WHEN 'revoked' THEN \"key_sha256\" IS NULL AND \"step_up_id\" IS NULL\n          AND \"revokes_key_id\" IS NOT NULL\n        ELSE false END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "corrector_key",
        "name": "corrector_key_insert_by_owner",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "app_auth"
        ],
        "using": null,
        "withCheck": "\"knowledge\".\"corrector_key\".\"kind\" = 'created' AND \"knowledge\".\"corrector_key\".\"actor_account_id\" = nullif(current_setting('app.account_id', true), '')::uuid\n        AND EXISTS (SELECT FROM \"auth\".\"step_up\"\n          WHERE \"auth\".\"step_up\".\"id\" = \"knowledge\".\"corrector_key\".\"step_up_id\"\n            AND \"auth\".\"step_up\".\"account_id\" = \"knowledge\".\"corrector_key\".\"actor_account_id\"\n            AND \"auth\".\"step_up\".\"purpose\" = 'corrector_key'\n            AND \"auth\".\"step_up\".\"consumed_at\" IS NOT NULL)",
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "corrector_key",
        "name": "corrector_key_revoke_by_definer",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "knowledge_definer"
        ],
        "using": null,
        "withCheck": "\"knowledge\".\"corrector_key\".\"kind\" = 'revoked'",
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "knowledge",
        "table": "corrector_key",
        "name": "corrector_key_select_by_definer",
        "as": "PERMISSIVE",
        "for": "SELECT",
        "roles": [
          "knowledge_definer"
        ],
        "using": "true",
        "withCheck": null,
        "entityType": "policies"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"auth\",\"step_up\",\"step_up_purpose\"]",
      "set": {
        "value": "\"purpose\" IN ('sensitive_settings', 'account_deletion', 'data_export', 'financial_action', 'vault_unlock', 'vault_write', 'knowledge_decision', 'admin_grant', 'corrector_key')"
      }
    },
    {
      "op": "alter",
