        "table": "channel",
        "name": "channel_p256dh_format",
        "value": "\"p256dh\" ~ '^[A-Za-z0-9_-]{87}$'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "notification",
