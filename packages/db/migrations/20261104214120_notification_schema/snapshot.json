      }
    },
    {
      "op": "create",
      "row": {
        "schema": "notification",
        "table": "channel",
        "name": "channel_device_format",
        "value": "\"browser\" ~ '^[a-z_]{1,32}$' AND \"os\" ~ '^[a-z_]{1,32}$'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
