    {
      "op": "create",
      "row": {
        "schema": "notification",
        "table": "channel",
        "name": "channel_fields_by_kind",
        "value": "(\"kind\" = 'web_push' AND \"endpoint\" IS NOT NULL AND \"p256dh\" IS NOT NULL\n            AND \"auth_secret\" IS NOT NULL AND \"browser\" IS NOT NULL AND \"os\" IS NOT NULL)\n        OR (\"kind\" = 'email' AND \"endpoint\" IS NULL AND \"p256dh\" IS NULL\n            AND \"auth_secret\" IS NULL AND \"browser\" IS NULL AND \"os\" IS NULL)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "notification",
        "table": "channel",
        "name": "channel_endpoint_https",
        "value": "\"endpoint\" ~ '^https://' AND char_length(\"endpoint\") <= 2048",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
