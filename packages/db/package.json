{
  "name": "@arca/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audit-schema": {
      "types": "./dist/audit-schema.d.ts",
      "default": "./dist/audit-schema.js"
    },
    "./notice-schema": {
      "types": "./dist/notice-schema.d.ts",
      "default": "./dist/notice-schema.js"
    },
    "./auth-schema": {
      "types": "./dist/auth-schema.d.ts",
      "default": "./dist/auth-schema.js"
    },
    "./rate-limit-schema": {
      "types": "./dist/rate-limit-schema.d.ts",
      "default": "./dist/rate-limit-schema.js"
    },
    "./step-up-schema": {
      "types": "./dist/step-up-schema.d.ts",
      "default": "./dist/step-up-schema.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@arca/eslint-config": "workspace:*",
    "@arca/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  }
}
