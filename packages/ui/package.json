{
  "name": "@arca/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/ids": {
      "types": "./dist/theme/ids.d.ts",
      "default": "./dist/theme/ids.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "themes": "vitest run test/themes-css.test.ts --update"
  },
  "devDependencies": {
    "@arca/eslint-config": "workspace:*",
    "@arca/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "catalog:",
    "@fontsource-variable/dm-sans": "catalog:",
    "@fontsource-variable/fraunces": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource-variable/instrument-sans": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/manrope": "catalog:",
    "@fontsource-variable/nunito": "catalog:",
    "@fontsource-variable/source-sans-3": "catalog:",
    "@fontsource-variable/space-grotesk": "catalog:",
    "@fontsource-variable/work-sans": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@fontsource/instrument-serif": "catalog:",
    "@fontsource/opendyslexic": "catalog:",
    "@fontsource/young-serif": "catalog:",
    "lucide-react": "catalog:"
  }
}
