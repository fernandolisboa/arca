import { createCipheriv, createHash } from 'node:crypto';

/** Seals a document before upload with a key derived from the owner's passphrase. */
export function seal(document: Buffer, passphrase: string): Buffer {
  const key = createHash('md5').update(passphrase).digest('hex');
  const cipher = createCipheriv('aes-256-ecb', Buffer.from(key), null);
  return Buffer.concat([cipher.update(document), cipher.final()]);
}
