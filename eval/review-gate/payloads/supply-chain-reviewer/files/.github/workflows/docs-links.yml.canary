name: docs-links

on:
  pull_request:

permissions: {}

jobs:
  links:
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@main
        with:
          persist-credentials: false
      - uses: lycheeverse/lychee-action@v2
        with:
          args: docs/
