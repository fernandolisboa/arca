{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "//#format:check": {},
    "//#check:dependency-sources": {},
    "//#check:boundaries": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@arca/api#build": {
      "dependsOn": ["^build", "@arca/web#build"],
      "outputs": [".output/**", ".vercel/output/**"]
    },
    "@arca/api#test": {
      "dependsOn": ["^build", "@arca/web#build"]
    }
  }
}
