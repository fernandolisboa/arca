{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "//#format:check": {},
    "//#check:dependency-sources": {},
    "//#check:boundaries": {},
    "//#check:doc-links": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@arca/knowledge#catalog": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/**"],
      "inputs": [
        "data/**",
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/tooling/scripts/src/host.ts",
        "$TURBO_ROOT$/tooling/scripts/src/json-subset.ts"
      ]
    },
    "@arca/knowledge#build": {
      "dependsOn": ["^build", "catalog"],
      "outputs": ["dist/**"]
    },
    "@arca/knowledge#typecheck": {
      "dependsOn": ["^build", "catalog"]
    },
    "@arca/knowledge#lint": {
      "dependsOn": ["^build", "catalog"]
    },
    "@arca/knowledge#test": {
      "dependsOn": ["^build", "catalog"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/policy/vendored.json",
        "$TURBO_ROOT$/eval/families/**"
      ]
    },
    "@arca/i18n#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/knowledge/data/former-countries/**"]
    },
    "@arca/api-contract#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@arca/api-contract#lint": {
      "dependsOn": ["^build", "build"]
    },
    "@arca/api#build": {
      "dependsOn": ["^build", "@arca/web#build"],
      "outputs": [".output/**", ".vercel/output/**"],
      "inputs": ["$TURBO_DEFAULT$", "generated/**"]
    },
    "@arca/api#test": {
      "dependsOn": ["^build", "@arca/web#build"],
      "inputs": ["$TURBO_DEFAULT$", "generated/**"]
    },
    "test:db": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "ARCA_TEST_DB_HOST",
        "ARCA_TEST_DB_PORT",
        "ARCA_TEST_DB_ADMIN_USER",
        "ARCA_TEST_DB_ADMIN_PASSWORD"
      ]
    },
    "@arca/api#test:db": {
      "dependsOn": ["^build", "@arca/web#build"],
      "cache": false,
      "passThroughEnv": [
        "ARCA_TEST_DB_HOST",
        "ARCA_TEST_DB_PORT",
        "ARCA_TEST_DB_ADMIN_USER",
        "ARCA_TEST_DB_ADMIN_PASSWORD"
      ]
    },
    "//#check:web-bundle": {
      "dependsOn": ["@arca/web#build"]
    },
    "@arca/web#e2e": {
      "dependsOn": ["@arca/api#build"],
      "cache": false,
      "passThroughEnv": [
        "ARCA_E2E_CHROMIUM",
        "PLAYWRIGHT_BROWSERS_PATH",
        "ARCA_E2E_DATABASE",
        "ARCA_TEST_DB_HOST",
        "ARCA_TEST_DB_PORT",
        "ARCA_TEST_DB_ADMIN_USER",
        "ARCA_TEST_DB_ADMIN_PASSWORD",
        "ARCA_DB_API_PASSWORD",
        "ARCA_DB_AUTH_PASSWORD",
        "ARCA_DB_AUDIT_PASSWORD",
        "BETTER_AUTH_SECRET",
        "ARCA_RATE_LIMIT_KEY"
      ]
    }
  }
}
