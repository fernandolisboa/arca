{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "//#format:check": {},
    "//#check:dependency-sources": {},
    "//#check:boundaries": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@arca/api#build": {
      "dependsOn": ["^build", "@arca/web#build"],
      "outputs": [".output/**", ".vercel/output/**"],
      "inputs": ["$TURBO_DEFAULT$", "generated/**"]
    },
    "@arca/api#test": {
      "dependsOn": ["^build", "@arca/web#build"],
      "inputs": ["$TURBO_DEFAULT$", "generated/**"]
    },
    "@arca/scripts#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/agents/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/eval/review-gate/**"
      ]
    },
    "//#check:web-bundle": {
      "dependsOn": ["@arca/web#build"]
    },
    "@arca/web#e2e": {
      "dependsOn": ["@arca/api#build"],
      "cache": false,
      "passThroughEnv": ["ARCA_E2E_CHROMIUM", "PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
